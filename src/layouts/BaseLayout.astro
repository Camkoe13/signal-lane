---
interface Props { title: string; description?: string }
const { title, description = 'Curated AI research digests by specialty' } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><title>{title} | Signal Lane</title><link rel="icon" href="/favicon.svg" /><style is:global>
*{box-sizing:border-box;margin:0;padding:0} :root{--bg:#0f1419;--surface:#1a1f2e;--border:#2a3441;--text:#e6edf3;--muted:#8b949e;--accent:#58a6ff} body{font-family:system-ui,sans-serif;line-height:1.6;color:var(--text);background:var(--bg);padding:2rem}a{color:var(--accent);text-decoration:none}a:hover{text-decoration:underline}.container{max-width:1200px;margin:auto}header{padding-bottom:2rem;border-bottom:1px solid var(--border);margin-bottom:2rem}.site-title{font-size:1.5rem;font-weight:600;display:block;color:var(--text)}.tagline{color:var(--muted)}nav{display:flex;gap:1.5rem;flex-wrap:wrap;margin-top:1rem}nav a{color:var(--muted)}h1,h2,h3{line-height:1.3;margin-bottom:1rem}p{margin-bottom:1rem}ul{margin:0 0 1rem 1.5rem}footer{margin-top:4rem;padding-top:2rem;border-top:1px solid var(--border);color:var(--muted);text-align:center}.card{background:var(--surface);border:1px solid var(--border);border-radius:8px;padding:1.5rem}
</style></head><body><div class="container"><header><a href="/" class="site-title">Signal Lane</a><span class="tagline">Curated AI research digests by specialty</span><nav><a href="/">Home</a><a href="/verticals/anomaly-detection">Visual Anomaly Detection</a><a href="/verticals/agentic-security">Agentic Security</a><a href="/verticals/edge-inference">Edge Inference</a><a href="/about">About</a></nav></header><main><slot /></main><footer><p>&copy; 2026 Signal Lane. Ad-supported research curation.</p></footer></div></body></html>
