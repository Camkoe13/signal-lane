---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Curated AI research digests by specialty" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | Signal Lane</title>
    <link rel="icon" href={`${base}favicon.svg`} />
    <style is:global>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      :root {
        --color-bg: #0f1419;
        --color-surface: #1a1f2e;
        --color-border: #2a3441;
        --color-text: #e6edf3;
        --color-text-muted: #8b949e;
        --color-accent: #58a6ff;
        --color-accent-hover: #4493e6;
        --spacing-xs: 0.5rem;
        --spacing-sm: 1rem;
        --spacing-md: 1.5rem;
        --spacing-lg: 2rem;
        --spacing-xl: 3rem;
        --max-width: 1200px;
        --max-width-narrow: 800px;
      }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
        line-height: 1.6;
        color: var(--color-text);
        background: var(--color-bg);
        padding: var(--spacing-md);
      }
      h1, h2, h3 { line-height: 1.3; margin-bottom: var(--spacing-sm); }
      h1 { font-size: 2rem; font-weight: 600; }
      h2 { font-size: 1.5rem; font-weight: 600; }
      h3 { font-size: 1.25rem; font-weight: 600; }
      a { color: var(--color-accent); text-decoration: none; }
      a:hover { color: var(--color-accent-hover); text-decoration: underline; }
      p { margin-bottom: var(--spacing-sm); }
      ul, ol { margin-left: var(--spacing-md); margin-bottom: var(--spacing-sm); }
      li { margin-bottom: var(--spacing-xs); }
      .container { max-width: var(--max-width); margin: 0 auto; }
      header {
        padding: var(--spacing-lg) 0;
        border-bottom: 1px solid var(--color-border);
        margin-bottom: var(--spacing-xl);
      }
      .site-title {
        font-size: 1.5rem; font-weight: 600; color: var(--color-text);
        text-decoration: none; display: inline-block; margin-bottom: var(--spacing-xs);
      }
      .site-title:hover { color: var(--color-accent); text-decoration: none; }
      .site-tagline { color: var(--color-text-muted); font-size: 0.9rem; display: block; margin-bottom: var(--spacing-md); }
      nav { display: flex; gap: var(--spacing-md); flex-wrap: wrap; }
      nav a { color: var(--color-text-muted); font-size: 0.95rem; }
      nav a:hover { color: var(--color-text); }
      footer {
        margin-top: var(--spacing-xl); padding-top: var(--spacing-lg);
        border-top: 1px solid var(--color-border); text-align: center;
        color: var(--color-text-muted); font-size: 0.9rem;
      }
      .preview-banner {
        background: linear-gradient(135deg, #1a472a 0%, #2d5a3d 100%);
        border: 1px solid #3d6a4d; border-radius: 6px;
        padding: var(--spacing-sm) var(--spacing-md);
        margin-bottom: var(--spacing-xl); text-align: center;
      }
      .preview-banner strong { color: #7ee787; }
      .card {
        background: var(--color-surface); border: 1px solid var(--color-border);
        border-radius: 8px; padding: var(--spacing-md);
      }
      @media (max-width: 768px) {
        body { padding: var(--spacing-sm); }
        h1 { font-size: 1.75rem; }
        h2 { font-size: 1.35rem; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <a href={base} class="site-title">Signal Lane</a>
        <span class="site-tagline">Curated AI research digests by specialty</span>
        <nav>
          <a href={base}>Home</a>
          <a href={`${base}verticals/anomaly-detection`}>Visual Anomaly Detection</a>
          <a href={`${base}verticals/agentic-security`}>Agentic Security</a>
          <a href={`${base}verticals/edge-inference`}>Edge Inference</a>
          <a href={`${base}about`}>About</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <p>&copy; 2026 Signal Lane. Ad-supported research curation.</p>
      </footer>
    </div>
  </body>
</html>
